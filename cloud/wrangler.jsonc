{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-any-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {"PUBLIC_BASE_URL": "https://codex-any-bot.YOUR-SUBDOMAIN.workers.dev", "RELEASE_TAG": "v0.2.4"},
  "durable_objects": {"bindings": [{"name": "HUB", "class_name": "BotHub"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["BotHub"]}]
}
